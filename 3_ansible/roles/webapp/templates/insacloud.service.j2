# {{ ansible_managed }}
# Unité systemd générée pour {{ item.name }}
[Unit]
Description={{ item.description }}
{% if groups['workers'] | default([]) | length == 0 %}
# Mode mono-hôte : les conteneurs tournent ici, Docker doit être démarré avant
After=network-online.target docker.service
Requires=docker.service
{% else %}
# Mode multi-nœuds : les conteneurs sont sur les workers (pilotés par SSH)
After=network-online.target
Wants=network-online.target
{% endif %}

[Service]
Type=simple
User={{ insacloud_user }}
Group={{ insacloud_user }}
WorkingDirectory={{ insacloud_app_dir }}
# Variables d'environnement (dont la SECRET_KEY issue du Vault), fichier 0600 root
EnvironmentFile={{ insacloud_env_file }}
# Web : Gunicorn (4 workers, 0.0.0.0:5000) — Faucheur : interpréteur Python du venv
ExecStart={{ item.exec }}
# Arrêt propre : SIGTERM au processus principal, puis 15 s avant SIGKILL
KillMode=mixed
TimeoutStopSec=15
# Résilience : relance automatique en cas de crash
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
