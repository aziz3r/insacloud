# {{ ansible_managed }}
# Fichier d'environnement des services InsaCloud - CONTIENT DES SECRETS.
# Lu par systemd (EnvironmentFile=), permissions 0600 root.
INSACLOUD_SECRET_KEY={{ insacloud_secret_key }}

INSACLOUD_HOST=127.0.0.1
INSACLOUD_PORT={{ insacloud_web_port }}
# Derrière nginx en TLS : cookies Secure, HSTS, en-têtes X-Forwarded-* de confiance
INSACLOUD_HTTPS={{ '1' if insacloud_https | bool else '0' }}
INSACLOUD_BEHIND_PROXY=1
# Certificat monté dans les machines louées (terminal web + noVNC en HTTPS)
INSACLOUD_TLS_DIR={{ insacloud_tls_dir }}
{% for img in insacloud_images %}
INSACLOUD_IMAGE_{{ img.env }}={{ img.name }}:latest
{% endfor %}
# Images réellement disponibles (demo_mode) : l'application masque les autres choix
INSACLOUD_AVAILABLE_IMAGES={{ insacloud_images_to_build | map(attribute='name') | join(',') }}
INSACLOUD_PORT_MIN={{ insacloud_port_min }}
INSACLOUD_PORT_MAX={{ insacloud_port_max }}
INSACLOUD_MAX_INSTANCES={{ insacloud_max_instances }}
INSACLOUD_MAX_DURATION={{ insacloud_max_duration }}
INSACLOUD_CONTAINER_MEMORY={{ insacloud_container_memory }}
INSACLOUD_GUI_MEMORY={{ insacloud_gui_memory }}
INSACLOUD_FAUCHEUR_INTERVAL={{ insacloud_faucheur_interval }}
PYTHONUNBUFFERED=1
