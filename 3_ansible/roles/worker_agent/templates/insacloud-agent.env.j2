# {{ ansible_managed }}
# Configuration de l'agent. Fichier en 0600 : il porte le jeton partagé.
INSACLOUD_CONTROLLER={{ insacloud_controller_url }}
INSACLOUD_AGENT_TOKEN={{ insacloud_agent_token }}
INSACLOUD_WORKER_NAME={{ inventory_hostname }}
INSACLOUD_WORKER_IP={{ node_ip | default(ansible_host) | default(ansible_default_ipv4.address) }}
INSACLOUD_HEARTBEAT_INTERVAL={{ insacloud_heartbeat_interval }}
INSACLOUD_AGENT_INSECURE={{ insacloud_agent_insecure }}
