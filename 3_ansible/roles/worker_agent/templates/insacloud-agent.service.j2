# {{ ansible_managed }}
[Unit]
Description=InsaCloud - agent du nœud {{ inventory_hostname }}
Documentation=https://github.com/aziz3r/insacloud
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=simple
# L'agent lit le jeton partagé dans un fichier 0600 : il n'apparaît ni dans
# l'unité systemd, ni dans la table des processus, ni dans les journaux.
EnvironmentFile={{ insacloud_agent_env_file }}
ExecStart=/usr/bin/python3 {{ insacloud_root }}/worker_agent.py
Restart=always
RestartSec=10

# Durcissement : l'agent n'a besoin que de lire /proc et d'appeler Docker.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/run/docker.sock
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
