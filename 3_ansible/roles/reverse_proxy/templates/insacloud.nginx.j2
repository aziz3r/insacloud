# {{ ansible_managed }}
# InsaCloud — frontal nginx : TLS, HSTS, limitation de débit, proxy vers Gunicorn

# Limitation de débit sur la page de connexion (par adresse IP)
limit_req_zone $binary_remote_addr zone=insacloud_login:10m rate={{ nginx_login_rate }};

# 80 -> 443
server {
    listen 80;
    listen [::]:80;
    server_name {{ insacloud_server_name }} _;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name {{ insacloud_server_name }} _;

    ssl_certificate     {{ insacloud_tls_cert }};
    ssl_certificate_key {{ insacloud_tls_key }};
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers on;
    ssl_ciphers ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-ECDSA-AES128-GCM-SHA256;
    ssl_session_timeout 1d;
    ssl_session_cache shared:insacloud_ssl:10m;
    ssl_session_tickets off;

    # HSTS, CSP et autres en-têtes de sécurité sont posés par l'application (INSACLOUD_HTTPS=1)

    client_max_body_size 16k;
    access_log /var/log/nginx/insacloud.access.log;
    error_log  /var/log/nginx/insacloud.error.log;

    location = /login {
        limit_req zone=insacloud_login burst={{ nginx_login_burst }} nodelay;
        limit_req_status 429;
        include /etc/nginx/proxy_params;
        proxy_pass http://127.0.0.1:{{ insacloud_web_port }};
    }

    location /static/ {
        include /etc/nginx/proxy_params;
        proxy_pass http://127.0.0.1:{{ insacloud_web_port }};
        expires 1d;
    }

    location / {
        include /etc/nginx/proxy_params;
        proxy_pass http://127.0.0.1:{{ insacloud_web_port }};
    }
}
