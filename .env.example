# =============================================================================
#  .env.example - Variables attendues par docker-compose.yml
# -----------------------------------------------------------------------------
#  Copiez ce fichier en « .env » et remplissez-le AVANT le premier lancement.
#  .env est exclu du dépôt : il contient des secrets, jamais versionnés.
#
#      cp .env.example .env
#      # puis remplacez les valeurs À REMPLIR
#      docker compose up -d
#
#  Pour produire les deux clés :
#      python3 -c "import secrets; print(secrets.token_hex(32))"
#      python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# =============================================================================

# --- Base de données ---------------------------------------------------------
POSTGRES_USER=insacloud
POSTGRES_DB=insacloud
POSTGRES_PASSWORD=À_REMPLIR_mot_de_passe_de_la_base

# --- Secrets de l'application ------------------------------------------------
# Signature des cookies de session (64 caractères hexadécimaux)
INSACLOUD_SECRET_KEY=À_REMPLIR_token_hex_32
# Chiffrement Fernet des mots de passe root stockés en base (clé distincte)
INSACLOUD_VAULT_KEY=À_REMPLIR_cle_fernet
# Jeton partagé des agents installés sur les workers ; vide = enregistrement fermé
INSACLOUD_AGENT_TOKEN=À_REMPLIR_jeton_des_agents

# --- Identité du déploiement -------------------------------------------------
# Deux plateformes InsaCloud peuvent partager un même démon Docker : chacune
# n'agit que sur les machines portant SON nom de cluster.
INSACLOUD_CLUSTER=compose

# --- Exposition --------------------------------------------------------------
# 127.0.0.1 : accessible depuis ce poste seulement. 0.0.0.0 pour ouvrir au réseau.
INSACLOUD_BIND=127.0.0.1
INSACLOUD_HTTP_PORT=8088

# --- Accès au démon Docker ---------------------------------------------------
# L'application tourne sans privilège et doit appartenir au groupe propriétaire
# de /var/run/docker.sock pour créer les machines. Relevez la valeur ainsi :
#   docker run --rm -v /var/run/docker.sock:/var/run/docker.sock alpine \
#     stat -c '%g' /var/run/docker.sock
DOCKER_GID=999

# --- Parc de workers ---------------------------------------------------------
# Vide : les machines tournent sur le Docker local (pile de développement).
# Sinon : worker1=192.168.56.11,worker2=192.168.56.12
INSACLOUD_WORKERS=

# --- Règles métier -----------------------------------------------------------
INSACLOUD_MAX_INSTANCES=3
INSACLOUD_PORT_MIN=8000
INSACLOUD_PORT_MAX=9000
# Secondes sans battement de cœur avant de déclarer un worker hors ligne
INSACLOUD_HEARTBEAT_TIMEOUT=90
